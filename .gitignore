# Logs produced by the in-guest scripts at runtime
logs/
*.log

# Lambda build artifacts
lambda/**/build/
lambda/**/*.zip
__pycache__/
*.pyc

# Test / lint tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# Pester's -CI flag drops NUnit results + coverage files in the working directory
testResults.xml
coverage.xml

# Local operator overrides (never commit real instance IDs / secrets)
*.local.ps1
*.local.sh
.env
.env.*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
# Agent tooling keeps FULL repo copies under .claude/worktrees/, so an unguarded
# `git add -A` would stage thousands of stale duplicate sources as if they were
# real files. ci.yml's shellcheck discovery already excludes the path explicitly;
# this keeps it out of git's sight in the first place.
.claude/
